#!/usr/bin/env python3
"""
lazy/lazy - A Procrastinator's CLI Task Manager

This script provides the command-line interface for the Lazy tool.
It handles user input, parses arguments using argparse, and orchestrates
the application logic by invoking the database and utility modules.

Philosophy: "Why do today what you can push to tomorrow?"
"""

__version__ = "v2026.04.27"

import argparse
import sys
import json
import random
import os.path
from datetime import date, timedelta
from db import init_db, add_task, get_tasks, complete_task, delete_task, move_task, rename_task, get_task, push_tasks, get_connection
from utils import parse_date, load_config

# Basic ANSI color codes
COLOR_RED = "\033[91m"
COLOR_GREEN = "\033[92m"
COLOR_GRAY = "\033[90m"
STYLE_DIM = "\033[2m"
STYLE_BOLD = "\033[1m"
COLOR_RESET = "\033[0m"

# Aura Symbols
SYM_OVERDUE = "⚑"
SYM_TODAY = "●"
SYM_FUTURE = "○"

def print_tasks(tasks, show_date=False):
    """
    Formats and prints a list of tasks to the console with Aura Rendering.
    """
    if not tasks:
        config = load_config()
        messages = config.get('empty_state_messages', ["Nothing to do! (You lazy animal)"])
        print(random.choice(messages))
        return

    config = load_config()
    enable_colors = config.get('enable_colors', True)

    today_date = date.today()
    
    print(f"{ 'ID':<4} { 'Due Date':<15} {'Description'}")
    print("-" * 50)
    
    for task in tasks:
        t_id = str(task['id'])
        t_date_obj = date.fromisoformat(task['due_date'])
        t_desc = task['description']
        
        formatted_date = t_date_obj.strftime("%a %Y-%m-%d")
        
        prefix = ""
        suffix = COLOR_RESET if enable_colors else ""
        symbol = SYM_FUTURE

        if enable_colors:
            if t_date_obj < today_date:
                prefix = COLOR_RED + STYLE_BOLD # Overdue
                symbol = SYM_OVERDUE
            elif t_date_obj == today_date:
                prefix = COLOR_GREEN # Today
                symbol = SYM_TODAY
            elif t_date_obj <= today_date + timedelta(days=7):
                prefix = "" # Next Week (Normal console color)
                symbol = SYM_FUTURE
            else:
                prefix = COLOR_GRAY # Distant Future
                symbol = SYM_FUTURE
        
        if show_date: # For 'lazy l' (list all)
            print(f"{prefix}{t_id:<4} {formatted_date:<15} {symbol} {t_desc}{suffix}")
        else: # For 'lazy' (list today)
            if t_date_obj <= today_date:
                print(f"{prefix}{t_id:<4} {formatted_date:<15} {symbol} {t_desc}{suffix}")
            else:
                print(f"{prefix}{t_id:<4} {'':<15} {symbol} {t_desc}{suffix}")

# Command Handlers

def cmd_add(args, conn):
    """Handles 'lazy add' with Natural Echo."""
    input_list = args.task_input
    if not input_list:
        print("Error: Description required.")
        sys.exit(1)
        
    description = None
    d_date = None
    
    if len(input_list) >= 3:
        last_two = " ".join(input_list[-2:])
        try:
            d_date = parse_date(last_two)
            description = " ".join(input_list[:-2])
        except ValueError:
            pass
    
    if d_date is None and len(input_list) >= 2:
        last_one = input_list[-1]
        try:
            d_date = parse_date(last_one)
            description = " ".join(input_list[:-1])
            # Strip trailing prepositions
            for prep in ['in', 'at', 'on', 'for']:
                if description.lower().endswith(f" {prep}"):
                    description = description[:-(len(prep)+1)].strip()
                    break
        except ValueError:
            pass
            
    if d_date is None:
        description = " ".join(input_list)
        d_date = date.today()
        
    try:
        from utils import get_vibe_echo
        new_id = add_task(description, d_date, conn=conn)
        print(f"[{new_id}] {get_vibe_echo(description, d_date)}")
    except Exception as e:
        print(f"Error: {e}")

def cmd_list(args, conn):
    """Handles 'lazy list'."""
    tasks = get_tasks('all', conn=conn)
    print_tasks(tasks, show_date=True)

def cmd_one(args, conn):
    """Handles 'lazy focus'/'one'."""
    tasks = get_tasks('all', conn=conn)
    if not tasks:
        print_tasks(tasks)
        return
        
    task = tasks[0]
    print("\n" + "=" * 40)
    print("   DO THIS ONE THING")
    print("=" * 40 + "\n")
    
    t_id = str(task['id'])
    t_desc = task['description']
    t_date_obj = date.fromisoformat(task['due_date'])
    formatted_date = t_date_obj.strftime("%a %Y-%m-%d")
    
    note = " (OVERDUE!)" if t_date_obj < date.today() else ""
    
    print(f"[{t_id}] {t_desc}")
    print(f"Due: {formatted_date}{note}")
    print("\n" + "=" * 40 + "\n")

def cmd_done(args, conn):
    """Handles 'lazy done'."""
    task = get_task(args.id, conn=conn)
    if task:
        complete_task(args.id, conn=conn)
        config = load_config()
        praises = config.get('completion_messages', ["Completed."])
        print(f"[{args.id}] {task['description']} -> DONE.")
        print(f"✨ {random.choice(praises)}")
    else:
        print(f"Task [{args.id}] not found.")

def cmd_remove(args, conn):
    """Handles 'lazy rm'."""
    task = get_task(args.id, conn=conn)
    if task:
        delete_task(args.id, conn=conn)
        print(f"Deleted [{args.id}] \"{task['description']}\".")
    else:
        print(f"Task [{args.id}] not found.")

def cmd_move(args, conn):
    """Handles 'lazy move'."""
    task = get_task(args.id, conn=conn)
    if task:
        try:
            date_str = " ".join(args.date)
            new_date = parse_date(date_str)
            move_task(args.id, new_date, conn=conn)
            print(f"Moved [{args.id}] \"{task['description']}\" to {new_date}.")
        except ValueError as e:
            print(f"Error: {e}")
    else:
        print(f"Task [{args.id}] not found.")

def cmd_rename(args, conn):
    """Handles 'lazy rename'."""
    task = get_task(args.id, conn=conn)
    if task:
        new_desc = " ".join(args.description)
        if not new_desc:
            print("Error: New description required.")
            return
        rename_task(args.id, new_desc, conn=conn)
        print(f"Renamed [{args.id}] to \"{new_desc}\".")
    else:
        print(f"Task [{args.id}] not found.")

def cmd_view(args, conn):
    """Handles 'lazy view'."""
    task = get_task(args.id, conn=conn)
    if task:
        print("\n--- Task Details ---")
        print(f"ID:          {task['id']}")
        print(f"Description: {task['description']}")
        print(f"Due Date:    {task['due_date']}")
        print(f"Status:      {task['status']}")
        print(f"Created At:  {task['created_at']}")
        print("--------------------\n")
    else:
        print(f"Task [{args.id}] not found.")

def cmd_push(args, conn):
    """Handles 'lazy push'."""
    count = push_tasks(conn=conn)
    if count > 0:
        print(f"Pushed {count} task(s) to tomorrow. Breathe.")
    else:
        print("Nothing to push!")

def cmd_bump(args, conn):
    """Handles 'lazy bump'."""
    task_id = args.id
    if task_id is None:
        tasks = get_tasks('today', conn=conn)
        if not tasks:
            print("Nothing to bump!")
            return
        task_id = tasks[0]['id']

    task = get_task(task_id, conn=conn)
    if task:
        current_due = date.fromisoformat(task['due_date'])
        today = date.today()
        new_date = (max(current_due, today) + timedelta(days=1))
        move_task(task_id, new_date, conn=conn)
        print(f"Bumped [{task_id}] to {new_date}.")
    else:
        print(f"Task [{task_id}] not found.")

def cmd_triage(args, conn):
    """Handles 'lazy triage' with a high-status instant-key loop."""
    tasks = get_tasks('today', conn=conn)
    if not tasks:
        print("No tasks to triage today! Maximum chill.")
        return

    import termios
    import tty

    def get_key():
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(sys.stdin.fileno())
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        return ch

    print(f"\n{STYLE_BOLD}--- TRIAGE MODE ---{COLOR_RESET}")
    print("Keys: (d)one, (b)ump, (p)ush all, (s)kip, (q)uit")

    for task in tasks:
        t_id, t_desc = task['id'], task['description']
        print(f"\n[{t_id}] {STYLE_BOLD}{t_desc}{COLOR_RESET}")
        
        while True:
            sys.stdout.write("Action: ")
            sys.stdout.flush()
            key = get_key().lower()
            
            if key == 'd':
                complete_task(t_id, conn=conn)
                print(f"{COLOR_GREEN}DONE{COLOR_RESET}")
                break
            elif key == 'b':
                new_date = date.today() + timedelta(days=1)
                move_task(t_id, new_date, conn=conn)
                print(f"{COLOR_GRAY}BUMPED to tomorrow{COLOR_RESET}")
                break
            elif key == 'p':
                count = push_tasks(conn=conn)
                print(f"\n{COLOR_GRAY}PUSHED {count} tasks to tomorrow. Triage ending.{COLOR_RESET}")
                return
            elif key == 's':
                print("SKIPPED")
                break
            elif key == 'q':
                print("\nTRIAGE ABORTED.")
                return
            else:
                pass
                
    print(f"\n{STYLE_BOLD}--- TRIAGE COMPLETE ---{COLOR_RESET}")

def main():
    init_db()
    
    # Pre-parse check for 'lazy help' alias
    if len(sys.argv) > 1 and sys.argv[1] == 'help':
        sys.argv[1] = '--help'

    description = "Lazy - A Procrastinator's Task Manager"
    usage = """
  lazy                      List tasks due today or overdue
  lazy <desc> [date]        Add a task (e.g., 'lazy Buy milk tmw')
  
Commands:
  a, add, new <desc> [date] Add a task
  l, list, ls               List all pending tasks
  d, done <id>              Mark task as complete
  m, mv, move <id> <date>   Reschedule a task
  rn, re, edit <id> <desc>  Rename a task's description
  v, view, show <id>        View task details
  b, bump [id]              Move task to tomorrow
  p, push                   Push all today's tasks to tomorrow
  1, focus, one             Focus on the single most urgent task
  t, triage                 Interactively process today's tasks
"""
    parser = argparse.ArgumentParser(description=description, usage=usage, formatter_class=argparse.RawTextHelpFormatter, add_help=False)
    parser.add_argument('-h', '--help', action='help', help='Show this help message and exit')
    subparsers = parser.add_subparsers(dest='command')

    # Add (a)
    parser_add = subparsers.add_parser('a', aliases=['add', 'new'])
    parser_add.add_argument('task_input', nargs=argparse.REMAINDER)
    parser_add.set_defaults(func=cmd_add)

    # List (l)
    parser_list = subparsers.add_parser('l', aliases=['list', 'ls'])
    parser_list.set_defaults(func=cmd_list)

    # One (1)
    parser_one = subparsers.add_parser('one', aliases=['1', 'focus'])
    parser_one.set_defaults(func=cmd_one)
    
    # Done (d)
    parser_done = subparsers.add_parser('d', aliases=['done'])
    parser_done.add_argument('id', type=int)
    parser_done.set_defaults(func=cmd_done)

    # Remove (rm)
    parser_rm = subparsers.add_parser('rm', aliases=['remove', 'del', 'delete'])
    parser_rm.add_argument('id', type=int)
    parser_rm.set_defaults(func=cmd_remove)

    # Move (m)
    parser_mv = subparsers.add_parser('m', aliases=['mv', 'move', 'reschedule'])
    parser_mv.add_argument('id', type=int)
    parser_mv.add_argument('date', type=str, nargs=argparse.REMAINDER)
    parser_mv.set_defaults(func=cmd_move)

    # Rename (rn)
    parser_rn = subparsers.add_parser('rn', aliases=['re', 'rename', 'edit'])
    parser_rn.add_argument('id', type=int)
    parser_rn.add_argument('description', type=str, nargs=argparse.REMAINDER)
    parser_rn.set_defaults(func=cmd_rename)

    # View (v)
    parser_v = subparsers.add_parser('v', aliases=['view', 'show'])
    parser_v.add_argument('id', type=int)
    parser_v.set_defaults(func=cmd_view)

    # Push (p)
    parser_push = subparsers.add_parser('p', aliases=['push'])
    parser_push.set_defaults(func=cmd_push)

    # Bump (b)
    parser_bump = subparsers.add_parser('b', aliases=['bump'])
    parser_bump.add_argument('id', type=int, nargs='?')
    parser_bump.set_defaults(func=cmd_bump)

    # Triage (t)
    parser_triage = subparsers.add_parser('t', aliases=['triage'])
    parser_triage.set_defaults(func=cmd_triage)

    # Help
    subparsers.add_parser('help')

    if len(sys.argv) == 1:
        conn = get_connection()
        try:
            print_tasks(get_tasks('today', conn=conn))
        finally:
            conn.close()
        sys.exit(0)

    COMMAND_SPECS = {
        'l': None, 'list': None, 'ls': None,
        'p': None, 'push': None,
        't': None, 'triage': None,
        '1': None, 'one': None, 'focus': None,
        'd': 'id', 'done': 'id',
        'rm': 'id', 'remove': 'id', 'del': 'id', 'delete': 'id',
        'm': 'id', 'mv': 'id', 'move': 'id', 'reschedule': 'id',
        'rn': 'id', 're': 'id', 'rename': 'id', 'edit': 'id',
        'v': 'id', 'view': 'id', 'show': 'id',
        'b': 'id', 'bump': 'id',
        'a': 'special', 'add': 'special', 'new': 'special',
        'help': 'special', '-h': 'special', '--help': 'special'
    }

    if len(sys.argv) > 1:
        first_arg = sys.argv[1]
        should_inject_add = False
        if first_arg not in COMMAND_SPECS:
            if not first_arg.startswith('-'):
                should_inject_add = True
        else:
            spec = COMMAND_SPECS[first_arg]
            if spec == 'id':
                if len(sys.argv) > 2 and not sys.argv[2].isdigit():
                    if not sys.argv[2].startswith('-'):
                        should_inject_add = True
            elif spec is None:
                if len(sys.argv) > 2 and not sys.argv[2].startswith('-'):
                    should_inject_add = True
        if should_inject_add:
            sys.argv.insert(1, 'a')

    args = parser.parse_args()
    conn = get_connection()
    try:
        if hasattr(args, 'func'):
            args.func(args, conn)
        else:
            parser.print_help()
    finally:
        conn.close()

if __name__ == "__main__":
    main()
