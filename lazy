#!/usr/bin/env python3
"""lazy/lazy — A Procrastinator's CLI Task Manager.

Philosophy: "Why do today what you can push to tomorrow?"
"""

__version__ = "v2026.05.05"

import argparse
import random
import sys
from datetime import date, timedelta

from db import (add_task, complete_task, delete_task, get_connection, get_task,
                get_tasks, move_task, push_tasks, rename_task)
from utils import get_vibe_echo, load_config, parse_date

RED, GREEN, GRAY, BOLD, RESET = "\033[91m", "\033[92m", "\033[90m", "\033[1m", "\033[0m"
SYM_OVERDUE, SYM_TODAY, SYM_FUTURE = "⚑", "●", "○"
STRIPPABLE_PREPS = ('in', 'at', 'on', 'for')


def _aura(due, today):
    """Return (color_prefix, symbol) for a due date relative to today."""
    if due < today:                      return RED + BOLD, SYM_OVERDUE
    if due == today:                     return GREEN, SYM_TODAY
    if due <= today + timedelta(days=7): return "", SYM_FUTURE
    return GRAY, SYM_FUTURE


def print_tasks(tasks, show_date=False):
    """Render tasks with Aura colors. show_date=True forces date column for future items."""
    if not tasks:
        msgs = load_config().get('empty_state_messages', ["Nothing to do! (You lazy animal)"])
        print(random.choice(msgs))
        return

    enable_colors = load_config().get('enable_colors', True)
    today = date.today()

    print(f"{'ID':<4} {'Due Date':<15} Description")
    print("-" * 50)
    for task in tasks:
        due = date.fromisoformat(task['due_date'])
        prefix, symbol = _aura(due, today) if enable_colors else ("", SYM_FUTURE)
        suffix = RESET if enable_colors else ""
        date_col = due.strftime("%a %Y-%m-%d") if (show_date or due <= today) else ""
        print(f"{prefix}{str(task['id']):<4} {date_col:<15} {symbol} {task['description']}{suffix}")


def _split_description_and_date(words):
    """From an argv-style list, peel off a trailing date phrase. Returns (description, date)."""
    for take in (2, 1):
        if len(words) > take:
            try:
                d = parse_date(" ".join(words[-take:]))
                desc = " ".join(words[:-take]).strip()
                if take == 1:
                    for prep in STRIPPABLE_PREPS:
                        if desc.lower().endswith(f" {prep}"):
                            desc = desc[:-(len(prep) + 1)].rstrip()
                            break
                return desc, d
            except ValueError:
                continue
    return " ".join(words).strip(), date.today()


def cmd_add(args, conn):
    if not args.task_input:
        print("Error: Description required.")
        sys.exit(1)
    description, due = _split_description_and_date(args.task_input)
    new_id = add_task(description, due, conn)
    print(f"[{new_id}] {get_vibe_echo(description, due)}")


def cmd_list(args, conn):
    print_tasks(get_tasks('all', conn), show_date=True)


def cmd_one(args, conn):
    tasks = get_tasks('all', conn)
    if not tasks:
        print_tasks(tasks)
        return
    t = tasks[0]
    due = date.fromisoformat(t['due_date'])
    note = " (OVERDUE!)" if due < date.today() else ""
    bar = "=" * 40
    print(f"\n{bar}\n   DO THIS ONE THING\n{bar}\n")
    print(f"[{t['id']}] {t['description']}")
    print(f"Due: {due.strftime('%a %Y-%m-%d')}{note}")
    print(f"\n{bar}\n")


def cmd_done(args, conn):
    task = get_task(args.id, conn)
    if not task:
        print(f"Task [{args.id}] not found.")
        return
    complete_task(args.id, conn)
    praises = load_config().get('completion_messages', ["Completed."])
    print(f"[{args.id}] {task['description']} -> DONE.")
    print(f"✨ {random.choice(praises)}")


def cmd_remove(args, conn):
    task = get_task(args.id, conn)
    if not task:
        print(f"Task [{args.id}] not found.")
        return
    delete_task(args.id, conn)
    print(f"Deleted [{args.id}] \"{task['description']}\".")


def cmd_move(args, conn):
    task = get_task(args.id, conn)
    if not task:
        print(f"Task [{args.id}] not found.")
        return
    try:
        new_date = parse_date(" ".join(args.date))
    except ValueError as e:
        print(f"Error: {e}")
        return
    move_task(args.id, new_date, conn)
    print(f"Moved [{args.id}] \"{task['description']}\" to {new_date}.")


def cmd_rename(args, conn):
    task = get_task(args.id, conn)
    if not task:
        print(f"Task [{args.id}] not found.")
        return
    new_desc = " ".join(args.description).strip()
    if not new_desc:
        print("Error: New description required.")
        return
    rename_task(args.id, new_desc, conn)
    print(f"Renamed [{args.id}] to \"{new_desc}\".")


def cmd_view(args, conn):
    task = get_task(args.id, conn)
    if not task:
        print(f"Task [{args.id}] not found.")
        return
    print("\n--- Task Details ---")
    print(f"ID:          {task['id']}")
    print(f"Description: {task['description']}")
    print(f"Due Date:    {task['due_date']}")
    print(f"Status:      {task['status']}")
    print(f"Created At:  {task['created_at']}")
    print("--------------------\n")


def cmd_push(args, conn):
    count = push_tasks(conn)
    print(f"Pushed {count} task(s) to tomorrow. Breathe." if count else "Nothing to push!")


def cmd_bump(args, conn):
    task_id = args.id
    if task_id is None:
        tasks = get_tasks('today', conn)
        if not tasks:
            print("Nothing to bump!")
            return
        task_id = tasks[0]['id']
    task = get_task(task_id, conn)
    if not task:
        print(f"Task [{task_id}] not found.")
        return
    current_due = date.fromisoformat(task['due_date'])
    new_date = max(current_due, date.today()) + timedelta(days=1)
    move_task(task_id, new_date, conn)
    print(f"Bumped [{task_id}] to {new_date}.")


def cmd_triage(args, conn):
    """Interactive single-key triage: (d)one, (b)ump, (p)ush, (s)kip, (q)uit."""
    import termios
    import tty

    def get_key():
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            return sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)

    tasks = get_tasks('today', conn)
    if not tasks:
        print("No tasks to triage today! Maximum chill.")
        return

    print(f"\n{BOLD}--- TRIAGE MODE ---{RESET}")
    print("Keys: (d)one, (b)ump, (p)ush all, (s)kip, (q)uit")

    for task in tasks:
        print(f"\n[{task['id']}] {BOLD}{task['description']}{RESET}")
        while True:
            sys.stdout.write("Action: ")
            sys.stdout.flush()
            key = get_key().lower()
            if key == 'd':
                complete_task(task['id'], conn)
                print(f"{GREEN}DONE{RESET}")
                break
            if key == 'b':
                move_task(task['id'], date.today() + timedelta(days=1), conn)
                print(f"{GRAY}BUMPED to tomorrow{RESET}")
                break
            if key == 'p':
                count = push_tasks(conn)
                print(f"\n{GRAY}PUSHED {count} tasks to tomorrow. Triage ending.{RESET}")
                return
            if key == 's':
                print("SKIPPED")
                break
            if key == 'q':
                print("\nTRIAGE ABORTED.")
                return

    print(f"\n{BOLD}--- TRIAGE COMPLETE ---{RESET}")


# Dispatch table: name -> (aliases, takes_id, accepts_extra, func).
# `takes_id` means the first positional is an integer task ID.
# `accepts_extra` means the command legitimately consumes trailing words.
COMMANDS = [
    ('a',   ['add', 'new'],            False, True,  cmd_add),
    ('l',   ['list', 'ls'],            False, False, cmd_list),
    ('one', ['1', 'focus'],            False, False, cmd_one),
    ('d',   ['done'],                  True,  False, cmd_done),
    ('rm',  ['remove', 'del', 'delete'], True, False, cmd_remove),
    ('m',   ['mv', 'move', 'reschedule'], True, True,  cmd_move),
    ('rn',  ['re', 'rename', 'edit'],  True,  True,  cmd_rename),
    ('v',   ['view', 'show'],          True,  False, cmd_view),
    ('p',   ['push'],                  False, False, cmd_push),
    ('b',   ['bump'],                  True,  False, cmd_bump),
    ('t',   ['triage'],                False, False, cmd_triage),
]


def _build_parser():
    usage = """
  lazy                      List tasks due today or overdue
  lazy <desc> [date]        Add a task (e.g., 'lazy Buy milk tmw')

Commands:
  a, add, new <desc> [date] Add a task
  l, list, ls               List all pending tasks
  d, done <id>              Mark task as complete
  rm, del <id>              Delete a task permanently
  m, mv, move <id> <date>   Reschedule a task
  rn, re, edit <id> <desc>  Rename a task's description
  v, view, show <id>        View task details
  b, bump [id]              Move task to tomorrow
  p, push                   Push all today's tasks to tomorrow
  1, focus, one             Focus on the single most urgent task
  t, triage                 Interactively process today's tasks
"""
    parser = argparse.ArgumentParser(
        description="Lazy - A Procrastinator's Task Manager",
        usage=usage, formatter_class=argparse.RawTextHelpFormatter, add_help=False
    )
    parser.add_argument('-h', '--help', action='help', help='Show this help message and exit')
    subs = parser.add_subparsers(dest='command')
    for name, aliases, takes_id, accepts_extra, func in COMMANDS:
        sp = subs.add_parser(name, aliases=aliases)
        if name == 'a':
            sp.add_argument('task_input', nargs=argparse.REMAINDER)
        elif name == 'b':
            sp.add_argument('id', type=int, nargs='?')
        elif takes_id and accepts_extra:
            sp.add_argument('id', type=int)
            sp.add_argument('date' if name == 'm' else 'description',
                            type=str, nargs=argparse.REMAINDER)
        elif takes_id:
            sp.add_argument('id', type=int)
        sp.set_defaults(func=func)
    subs.add_parser('help')
    return parser


def _maybe_inject_add(parser):
    """Heuristic: if argv looks like 'lazy <not-a-command> ...', insert 'a' as the verb."""
    if len(sys.argv) <= 1:
        return
    known = set(parser._subparsers._group_actions[0].choices)
    known.update({'-h', '--help'})

    first = sys.argv[1]
    inject = False
    if first not in known:
        inject = not first.startswith('-')
    else:
        # Find the COMMAND row for this name/alias to learn its expected shape.
        row = next(((n, ti, ax) for n, al, ti, ax, _ in COMMANDS
                    if first == n or first in al), None)
        if row and len(sys.argv) > 2 and not sys.argv[2].startswith('-'):
            _, takes_id, accepts_extra = row
            if takes_id and not sys.argv[2].isdigit():
                inject = True
            elif not takes_id and not accepts_extra:
                inject = True
    if inject:
        sys.argv.insert(1, 'a')


def main():
    if len(sys.argv) > 1 and sys.argv[1] == 'help':
        sys.argv[1] = '--help'

    parser = _build_parser()

    if len(sys.argv) == 1:
        conn = get_connection()
        try:
            print_tasks(get_tasks('today', conn))
        finally:
            conn.close()
        return

    _maybe_inject_add(parser)
    args = parser.parse_args()
    conn = get_connection()
    try:
        if hasattr(args, 'func'):
            args.func(args, conn)
        else:
            parser.print_help()
    finally:
        conn.close()


if __name__ == "__main__":
    main()
